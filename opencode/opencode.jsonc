{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@gotgenes/opencode-agent-identity",
    "oh-my-opencode-slim",
    "@tarquinen/opencode-dcp@latest",
    "opencode-mem",
    "opencode-restart",
    "opencode-tui-image-clipboard-fix@latest",
    "@slkiser/opencode-quota",
    //"@mrgray17/opentoken@latest",
    //"openrtk"
  ],
  "provider": {
    "local-llama": {
      "name": "Local llama-server",
      "api": "openai",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "id": "Qwen3.6-35B-A3B-UD-IQ3_XXS.gguf",
          "name": "Qwen 3.6 35B-A3B (UD-IQ3_XXS)",
          "cost": {
            "input": 0,
            "output": 0
          },
          "limit": {
            "context": 16000,
            "output": 4096
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "openrouter/openai/gpt-oss-120b:free",
  "lsp": false,
  "compaction": {
    "tail_turns": 1
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  }
}
