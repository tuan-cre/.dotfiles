#!/usr/bin/env python3
"""Native messaging host for Meme Collection browser extension.
Receives image data from the extension and saves it to the collection."""

import sys
import os
import json
import struct
import base64
import time
import subprocess
import io
from PIL import Image

MEME_DIR = os.path.expanduser("~/.local/share/memes")


def send_message(message: dict) -> None:
    """Send a JSON message to the browser extension via stdout."""
    encoded = json.dumps(message).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("I", len(encoded)))
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.flush()


def read_message() -> dict:
    """Read a JSON message from the browser extension via stdin."""
    raw = sys.stdin.buffer.read(4)
    if not raw or len(raw) < 4:
        return {}
    length = struct.unpack("I", raw)[0]
    data = sys.stdin.buffer.read(length)
    return json.loads(data.decode("utf-8"))


def save_image(mime_type: str, data_b64: str) -> dict:
    """Decode base64 image data and save to collection.
    Converts webp to PNG for better compatibility with the meme tools."""

    ext = mime_type.split("/")[-1]
    if ext == "jpeg":
        ext = "jpg"
    elif ext not in ("png", "jpg", "gif", "webp", "svg"):
        ext = "png"

    os.makedirs(MEME_DIR, exist_ok=True)

    try:
        image_data = base64.b64decode(data_b64)

        # Convert webp to PNG for better tool compatibility
        if ext == "webp":
            img = Image.open(io.BytesIO(image_data))
            buf = io.BytesIO()
            img.save(buf, "PNG")
            image_data = buf.getvalue()
            ext = "png"

        filename = f"meme_{int(time.time())}.{ext}"
        filepath = os.path.join(MEME_DIR, filename)

        with open(filepath, "wb") as f:
            f.write(image_data)

        # Copy to clipboard
        mime_map = {
            "png": "image/png",
            "jpg": "image/jpeg",
            "gif": "image/gif",
            "webp": "image/webp",
            "svg": "image/svg+xml",
        }
        clipboard_mime = mime_map.get(ext, "image/png")
        subprocess.run(
            ["wl-copy", "--type", clipboard_mime],
            input=image_data,
            check=False,
        )

        # Notify
        subprocess.run(
            ["notify-send", "-i", filepath, "Meme Collection", f"Saved: {filename}"],
            check=False,
        )

        return {"success": True, "filename": filename}
    except Exception as e:
        return {"success": False, "error": str(e)}


def main():
    # Ensure memes directory exists
    os.makedirs(MEME_DIR, exist_ok=True)

    message = read_message()
    if not message:
        send_message({"success": False, "error": "No message received"})
        return

    action = message.get("action", "")

    if action == "save":
        result = save_image(
            message.get("mimeType", "image/png"),
            message.get("data", ""),
        )
        send_message(result)
    elif action == "ping":
        send_message({"success": True, "pong": True})
    else:
        send_message({"success": False, "error": f"Unknown action: {action}"})


if __name__ == "__main__":
    main()
